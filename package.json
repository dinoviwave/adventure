{
  "name": "adventure",
  "version": "0.9.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "wrangler dev",
    "dev:demo": "wrangler dev -c wrangler.demo.toml --inspector-port 9230",
    "build:demo": "python3 scripts/build_demo.py",
    "db:local": "wrangler d1 migrations apply adventure --local",
    "deploy": "python3 scripts/make_version.py && wrangler deploy",
    "deploy:demo": "wrangler deploy -c wrangler.demo.toml",
    "update": "git stash && git pull origin main && (git stash pop || true) && npm i && npm run build:demo && npm run deploy && npm run deploy:demo",
    "db:remote": "wrangler d1 migrations apply adventure --remote"
  },
  "keywords": [],
  "author": "",
